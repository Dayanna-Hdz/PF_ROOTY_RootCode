@page
@using PF_ROOTY_RootCode.Pages
@{
    ViewData["Title"] = "Mapa de Puntos - Rooty";
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <!-- ------------------ CONFIGURACION Y ESTILOS ------------------ -->
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>

    <!-- ------------------ CABECERA / NAVEGACION ------------------ -->
    <header class="header-landing">
        <div class="logo-landing">🌱 Rooty</div>
        <div class="botones-header">
            <a href="/MenuPrincipal" class="btn-login-nav">← Volver al Menú</a>
        </div>
    </header>

    <!-- ------------------ CONTENIDO PRINCIPAL ------------------ -->
    <main class="contenedor-hero">
        <h1 class="titulo-hero">Sección Mapa de Puntos</h1>
    </main>

    <!-- ------------------ PIE DE PAGINA ------------------ -->
    <footer class="footer-global">
        <p>Rooty - Plataforma de Reciclaje</p>
    </footer>

</body>
</html>