@page
@using PF_ROOTY_RootCode.Pages
@model IndexModel
@{
    ViewData["Title"] = "Inicio - Rooty";
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <!-- Estilos de Leaflet -->
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />

    @* --------------------- ESTILOS DE LA SECCION DE PUNTOS DE ACOPIO --------------------- *@
    <style>
        .seccion-puntos-acopio {
            padding: 4rem 1.5rem;
            background-color: #ffffff;
        }

        .contenedor-puntos-acopio {
            max-width: 1150px;
            margin: 0 auto;
        }

        .encabezado-puntos-acopio {
            text-align: center;
            margin-bottom: 2rem;
        }

            .encabezado-puntos-acopio h2 {
                color: var(--color-primario-oscuro);
                font-size: clamp(1.5rem, 5vw, 2rem);
                margin: 0 0 0.5rem 0;
            }

            .encabezado-puntos-acopio p {
                color: #666666;
                font-size: 1.05rem;
                margin: 0;
            }

        .layout-puntos-publico {
            display: grid;
            grid-template-columns: 370px 1fr;
            gap: 1.5rem;
            background: var(--color-tarjeta);
            padding: 1.5rem;
            border-radius: 16px;
            box-shadow: 0 4px 16px rgba(0, 0, 0, 0.06);
            border: 1px solid #e0e6e3;
        }

        .mapa-publico-marco {
            border-radius: 12px;
            overflow: hidden;
            border: 1px solid #d5e0da;
            height: 520px;
        }

        #mapaPublicoRooty {
            width: 100%;
            height: 100%;
            z-index: 1;
        }

        .aviso-sin-puntos {
            text-align: center;
            padding: 2rem 1rem;
            color: #78909c;
        }

        @@media (max-width: 900px) {
            .layout-puntos-publico {
                grid-template-columns: 1fr;
                padding: 1rem;
            }

            .mapa-publico-marco {
                height: 340px;
            }
        }

        @@media (max-width: 768px) {
            .seccion-puntos-acopio {
                padding: 2.5rem 1rem;
            }
        }
    </style>
</head>
<body>

    @* --------------------- BARRA DE NAVEGACION --------------------- *@
    <header class="barra-navegacion" id="navbarPublica">
        <div class="icono-logo">🌱 Rooty</div>
        <button type="button" class="btn-menu-movil" id="btnMenuPublico" aria-label="Abrir menú">☰</button>
        <nav class="enlaces-navegacion">
            <a href="#que-es-rooty" onclick="cerrarMenuPublico()">¿Qué es Rooty?</a>
            <a href="#como-funciona" onclick="cerrarMenuPublico()">¿Cómo Funciona?</a>
            <a href="#puntos-acopio" onclick="cerrarMenuPublico()">Puntos de Acopio</a>
        </nav>
        <div class="botones-header">
            <a href="/Login" class="btn-login-nav">Iniciar Sesión</a>
            <a href="/Registro" class="btn-registro-nav">Registrarse</a>
        </div>
    </header>

    @* --------------------- INICIO --------------------- *@
    <section class="seccion-inicio">
        <h1 class="titulo-principal-rooty">ROOTY</h1>
        <div class="slogan-rooty">Recicla PET, acumula puntos y transforma tu entorno</div>
        <p class="descripcion-inicio-corta">
            La plataforma que recompensa tu reciclaje de botellas de plástico.
        </p>
        <div class="acciones-hero">
            <a href="/Registro" class="btn-principal-reciclar">¡Empieza a Reciclar!</a>
        </div>
    </section>

    @* --------------------- QUE ES ROOTY Y CALCULO DE CO2 --------------------- *@
    <section id="que-es-rooty" class="seccion-que-es">
        <div class="contenedor-que-es">
            <h2>¿Qué es Rooty?</h2>
            <p>
                <strong>Rooty</strong> Es un sistema de recompensas enfocado en el reciclaje de botellas de plástico. <strong>PET</strong>
            </p>

            <div class="tarjeta-calculo-co2">
                <div class="icono-co2">🌱 💨</div>
                <h3>¿Cómo Medimos tu Impacto Ambiental?</h3>
                <p>
                    Cada vez que entregas tus botellas PET, nuestro sistema calcula automáticamente el dióxido de carbono que evitas emitir al planeta.
                </p>
                <div class="equivalencia-co2-box">
                    <div class="item-formula">
                        <strong>1 kg de PET reciclado</strong>
                    </div>
                    <div class="flecha-formula">➜</div>
                    <div class="item-formula destaque-co2">
                        <strong>1.50 kg de CO₂ Evitado</strong>
                    </div>
                </div>

            </div>
        </div>
    </section>

    @* --------------------- COMO FUNCIONA EL SISTEMA --------------------- *@
    <section id="como-funciona" class="seccion-como-funciona">
        <h2>¿Cómo Funciona Nuestro Sistema?</h2>
        <p class="subtitulo-seccion">Aprende cómo usar Rooty en cuatro pasos sencillos:</p>

        <div class="tarjetas-pasos-contenedor">
            <div class="tarjeta-paso">
                <div class="numero-paso">1</div>
                <h4>Regístrate</h4>
                <p>Crea tu cuenta en la plataforma de manera rápida y gratuita.</p>
            </div>

            <div class="tarjeta-paso">
                <div class="numero-paso">2</div>
                <h4>Localiza un Punto</h4>
                <p>Ubica el centro de acopio de plástico PET más cercano a ti.</p>
            </div>

            <div class="tarjeta-paso">
                <div class="numero-paso">3</div>
                <h4>Escanea el  QR y  Registra tu Aporte</h4>
                <p>Entrega tus botellas PET e ingresa los kilogramos recolectados en tu cuenta</p>
            </div>

            <div class="tarjeta-paso">
                <div class="numero-paso">4</div>
                <h4>Obtén Recompensas</h4>
                <p>Acumula puntos por tu material reciclado y canjéalos por recompensas e insignias.</p>
            </div>
        </div>
    </section>

    @* --------------------- PUNTOS DE ACOPIO (LISTA + MAPA) --------------------- *@
    <section id="puntos-acopio" class="seccion-puntos-acopio">
        <div class="contenedor-puntos-acopio">

            <div class="encabezado-puntos-acopio">
                <h2>Conoce nuestros puntos de acopio</h2>
                <p>Encuentra el centro más cercano a ti y entrega tus botellas PET.</p>
            </div>

            @if (Model.ListaPuntos.Count == 0)
            {
                <div class="aviso-sin-puntos">Por el momento no hay puntos de acopio disponibles.</div>
            }
            else
            {
                <div class="layout-puntos-publico">

                    @* Lista de centros (clic para ubicarlos en el mapa) *@
                    <div class="lista-puntos-panel">
                        <div class="lista-puntos-header">
                            <h3>Centros de Acopio (@Model.ListaPuntos.Count)</h3>
                            <span>Clic para ver en el mapa</span>
                        </div>

                        <div class="lista-puntos-scroll">
                            @for (int i = 0; i < Model.ListaPuntos.Count; i++)
                            {
                                var p = Model.ListaPuntos[i];
                                <div class="tarjeta-punto-item" id="card-punto-@i" onclick="verPuntoEnMapa(@i)">
                                    <div class="punto-badge-num">@(i + 1)</div>
                                    <div class="punto-detalle-texto">
                                        <h4>@p.NombrePunto</h4>
                                        <p>📍 @p.UbicacionDetalle</p>
                                        <span class="estado-punto-abierto">● Recepción activa de Botellas PET</span>
                                    </div>
                                </div>
                            }
                        </div>
                    </div>

                    @* Mapa *@
                    <div class="mapa-publico-marco" id="marcoMapaPublico">
                        <div id="mapaPublicoRooty"></div>
                    </div>

                </div>
            }

        </div>
    </section>

    @* --------------------- PIE DE PAGINA --------------------- *@
    <footer class="pie-pagina">
        <p><small>Rooty - Plataforma de Reciclaje PET</small></p>
    </footer>

    @* --------------------- LOGICA DEL MAPA PUBLICO Y MENU MOVIL --------------------- *@
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script>
        const navbarPublica = document.getElementById('navbarPublica');
        const btnMenuPublico = document.getElementById('btnMenuPublico');

        if (btnMenuPublico && navbarPublica) {
            btnMenuPublico.addEventListener('click', () => {
                const abierto = navbarPublica.classList.toggle('menu-abierto');
                btnMenuPublico.textContent = abierto ? '✕' : '☰';
            });
        }

        function cerrarMenuPublico() {
            if (navbarPublica && navbarPublica.classList.contains('menu-abierto')) {
                navbarPublica.classList.remove('menu-abierto');
                if (btnMenuPublico) btnMenuPublico.textContent = '☰';
            }
        }

        const puntosData = @Html.Raw(Model.PuntosJson);
        const mapaEl = document.getElementById('mapaPublicoRooty');
        const marcadores = [];
        let mapa = null;

        if (mapaEl && puntosData.length > 0) {
            // Centro inicial del mapa (Monterrey, N.L.). Cambia las coordenadas si quieres otro punto de partida.
            mapa = L.map('mapaPublicoRooty').setView([25.6950, -100.3100], 11);

            L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                maxZoom: 19,
                attribution: '&copy; OpenStreetMap | Rooty'
            }).addTo(mapa);

            setTimeout(() => mapa.invalidateSize(), 250);

            const iconoRooty = L.divIcon({
                className: 'custom-pin-rooty',
                html: `<div class="pin-verde">🌱</div>`,
                iconSize: [36, 36],
                iconAnchor: [18, 36],
                popupAnchor: [0, -34]
            });

            puntosData.forEach((punto, idx) => {
                const marker = L.marker([punto.Latitud, punto.Longitud], { icon: iconoRooty }).addTo(mapa);

                marker.bindPopup(`
                    <div class="popup-rooty">
                        <strong>${punto.NombrePunto}</strong>
                        <p>${punto.UbicacionDetalle}</p>
                    </div>
                `);

                // Al tocar un marcador se resalta su tarjeta en la lista
                marker.on('click', () => resaltarTarjeta(idx));
                marcadores.push(marker);
            });
        }

        // --------------------- RESALTAR TARJETA EN LA LISTA ---------------------
        function resaltarTarjeta(indice) {
            document.querySelectorAll('.tarjeta-punto-item').forEach(el => el.classList.remove('seleccionado'));
            const tarjeta = document.getElementById('card-punto-' + indice);
            if (tarjeta) {
                tarjeta.classList.add('seleccionado');
                tarjeta.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
            }
        }

        // --------------------- UBICAR UN CENTRO EN EL MAPA DESDE LA LISTA ---------------------
        function verPuntoEnMapa(indice) {
            const punto = puntosData[indice];
            const marker = marcadores[indice];
            if (!mapa || !punto || !marker) return;

            if (window.innerWidth <= 900) {
                const marco = document.getElementById('marcoMapaPublico');
                if (marco) marco.scrollIntoView({ behavior: 'smooth', block: 'center' });
            }

            mapa.flyTo([punto.Latitud, punto.Longitud], 15, { duration: 1.0 });
            marker.openPopup();
            resaltarTarjeta(indice);
        }
    </script>

</body>
</html>
